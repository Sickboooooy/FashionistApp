{
  "name": "ecommerce-wars",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Laboratorio de competencia comercial multiagente. Simulación económica: no usa dinero real.",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"node_modules/**\" \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "preflight": "node scripts/preflight.ts",
    "torneo": "node scripts/torneo.ts",
    "verificar": "node scripts/verificar.ts",
    "reproducibilidad": "node scripts/reproducibilidad.ts",
    "servir": "node scripts/servir.ts",
    "sellar-reglas": "node scripts/sellar-reglas.ts",
    "banco": "node scripts/banco.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9"
  }
}
